{
  "name": "saas-task-platform",
  "version": "0.1.0",
  "description": "SaaS task management platform - Day 46-55 全栈实战 + Day 56 测试",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build && pnpm build:worker",
    "build:worker": "esbuild src/server/notifications/mail-worker.ts --bundle --platform=node --target=node20 --format=cjs --outfile=.worker/mail-worker.cjs --external:@prisma/client",
    "start": "next start",
    "start:standalone": "node .next/standalone/server.js",
    "start:worker": "node .worker/mail-worker.cjs",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:db:create": "docker compose exec -T postgres createdb -U saas saas_test",
    "test:migrate": "pnpm test:db:create || true && dotenv -e .env.test -- prisma migrate deploy",
    "test:e2e": "playwright test",
    "test:e2e:db": "docker compose exec -T postgres createdb -U saas saas_e2e || true",
    "worker:mail": "tsx src/server/notifications/mail-worker.ts",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@tanstack/react-query": "^4.44.0",
    "@trpc/client": "^10.45.2",
    "@trpc/react-query": "^10.45.4",
    "@trpc/server": "^10.45.2",
    "bullmq": "^5.58.5",
    "cookie": "^0.6.0",
    "ioredis": "^5.7.0",
    "lucide-react": "^0.468.0",
    "next": "^14.2.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "superjson": "^2.2.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/cookie": "^0.6.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^3.0.0",
    "dotenv-cli": "^7.4.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.25",
    "esbuild": "^0.25.0",
    "prisma": "^5.22.0",
    "tsx": "^4.20.5",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  }
}
