# 集成测试环境变量模板。复制为 .env.test 使用：
#   cp .env.test.example .env.test
# 端口对应 docker-compose.yml 映射出来的开发实例；
# 数据库用独立的 saas_test，避免每轮测试 TRUNCATE 掉开发数据。
# Redis 用 db 15，和开发队列（db 0）隔开。
DATABASE_URL="postgresql://saas:saas@localhost:5547/saas_test?schema=public"
REDIS_URL="redis://localhost:6547/15"
SESSION_SECRET="test-session-secret-at-least-32-bytes"
NEXT_PUBLIC_APP_NAME="SaaS Task Platform"
