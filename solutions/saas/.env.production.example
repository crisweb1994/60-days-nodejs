# docker-compose.prod.yml 的本地生产演练参数。
APP_PORT=3100
POSTGRES_USER=saas
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=saas
SESSION_SECRET=replace-with-at-least-32-random-bytes
NEXT_PUBLIC_APP_NAME=SaaS Task Platform
NPM_REGISTRY=https://registry.npmmirror.com
PRISMA_ENGINES_MIRROR=https://registry.npmmirror.com/-/binary/prisma

# 云平台部署时通常直接注入下面两条托管服务连接串，不使用 Compose 内部主机名。
DATABASE_URL=postgresql://user:password@host:5432/saas?schema=public&sslmode=require
REDIS_URL=rediss://default:password@host:6379/0
